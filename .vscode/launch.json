{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GeometriaFactory.Api (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/GeometriaFactory.Api/bin/Debug/net10.0/GeometriaFactory.Api.dll",
      "cwd": "${workspaceFolder}/src/GeometriaFactory.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "console": "internalConsole"
    },
    {
      "name": "GeometriaFactory.Web (F5)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/GeometriaFactory.Web/bin/Debug/net10.0/GeometriaFactory.Web.dll",
      "cwd": "${workspaceFolder}/src/GeometriaFactory.Web",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "console": "internalConsole"
    }
  ],
  "compounds": [
    {
      "name": "Las dos piezas desplegables",
      "configurations": ["GeometriaFactory.Api (F5)", "GeometriaFactory.Web (F5)"]
    }
  ]
}
