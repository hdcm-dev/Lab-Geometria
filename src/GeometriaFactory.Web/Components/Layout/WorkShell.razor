@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject SessionState Session

@* SHELL DE TRABAJO — `Experiencia-De-Uso.md` §3.2, segundo diagrama.
   «Barra lateral fija con la identidad del laboratorio arriba, tres destinos según el papel al
   medio, y al pie —separados por una línea tenue— la identidad de la persona, el cierre de
   sesión y el sello de versión.»

   LOS TRES DESTINOS POR PAPEL son los de la tabla de §3.2 y los de `Maqueta.js`, constante
   `DESTINOS` (`Linea-Base-Visual.md` §7, `EV-04`). NINGUNA BARRA LATERAL MUESTRA EL DESTINO DEL
   OTRO PAPEL, ni siquiera deshabilitado.

   DE DÓNDE SALE EL PAPEL DESDE LA ETAPA `c`. Con sesión abierta, DE LA SESIÓN. Sin sesión
   —prerrenderizado, o una dirección escrita a mano sin haber entrado— se cae al repliegue de la
   etapa `b`: la ruta, y el parámetro `papel` de la dirección en las dos superficies que los dos
   papeles comparten, que es lo que hace la maqueta (`Credencial-Propia.html?papel=administrador`).
   El repliegue se conserva porque es lo que mantiene en pie las pantallas de marcador de
   posición de las etapas siguientes, que todavía no tienen de dónde sacar una sesión.

   EL CIERRE DE SESIÓN ES UN ACTO Y NO UN ENLACE. Descarta la credencial del estado del circuito
   ANTES de navegar; el enlace de la etapa `b` sólo cambiaba de pantalla y dejaba la credencial
   viva. El correo que se muestra al pie sale de la sesión: es un dato de identidad, no la
   credencial, y es lo único de la sesión que llega al navegador. *@

<a class="gf-skip-link" href="#main-content">Ir al contenido</a>

<div class="gf-shell">
    <nav class="gf-shell-sidebar" aria-label="Navegación del laboratorio">
        <span class="gf-identity"><Icon Name="Brand" SizeClass="gf-icon--24" />Fábrica de Geometría</span>

        <ul class="gf-nav gf-flat-list--tight">
            @foreach (var destination in Destinations)
            {
                <li>
                    @* El destino en curso se marca con `aria-current="page"`, que es a la vez el
                       anuncio para quien navega con lector y el gancho de estilo de la hoja
                       (`.gf-nav a[aria-current="page"]`). No se usa `NavLink` porque su marca es
                       una clase CSS y el sistema visual portado no tiene regla para esa clase. *@
                    <a href="@destination.Href"
                       aria-current="@(IsCurrent(destination) ? "page" : null)">
                        <Icon Name="@destination.Icon" SizeClass="gf-icon--20" />@destination.Label
                    </a>
                </li>
            }
        </ul>

        <div class="gf-sidebar-footer">
            @if (Session.IsOpen)
            {
                <span class="gf-sidebar-person">@Session.Email</span>
            }
            <span class="gf-sidebar-role">@RoleLabel</span>
            <button type="button" class="gf-btn gf-btn--secondary" @onclick="SignOut">
                <Icon Name="SignOut" />Cerrar sesión
            </button>
            <VersionSeal />
        </div>
    </nav>

    <div class="gf-shell-content">
        <main id="main-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<DegradedStateOverlay />

@code {
    private sealed record Destination(string Label, string Href, string Icon);

    private static readonly Destination[] StudentDestinations =
    [
        new("Mis trabajos",  "/mis-trabajos",  "Works"),
        new("Trabajo nuevo", "/trabajo-nuevo", "New"),
        new("Mi contraseña", "/mi-contrasena?papel=alumno", "Key"),
    ];

    private static readonly Destination[] AdministratorDestinations =
    [
        new("Entrega de la comisión", "/entrega-comision", "ClassList"),
        new("Cuentas",                "/cuentas",          "Accounts"),
        new("Mi contraseña",          "/mi-contrasena?papel=administrador", "Key"),
    ];

    private bool _isAdministrator;

    private Destination[] Destinations => _isAdministrator ? AdministratorDestinations : StudentDestinations;

    private string RoleLabel => _isAdministrator ? "Administrador" : "Alumno";

    private string _path = "/";

    private bool IsCurrent(Destination destination)
    {
        var target = destination.Href.Split('?')[0];
        return string.Equals(_path, target, StringComparison.Ordinal);
    }

    /// Cerrar sesión: primero se descarta la credencial del circuito, y recién después se
    /// navega. El orden importa: al revés, la credencial sobreviviría a la navegación.
    private void SignOut()
    {
        Session.Close();
        Navigation.NavigateTo("/ingreso?estado=sesion-cerrada");
    }

    protected override void OnParametersSet()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var path = uri.AbsolutePath;
        _path = path;

        // Rutas propias del administrador. Las del alumno son el resto, y son el valor por
        // defecto, igual que en la maqueta (`DESTINOS[papel] || DESTINOS.alumno`).
        _isAdministrator = Session.IsOpen
            ? Session.IsAdministrator
            : path.StartsWith("/entrega-comision", StringComparison.Ordinal) ||
              path.StartsWith("/cuentas", StringComparison.Ordinal) ||
              uri.Query.Contains("papel=administrador", StringComparison.Ordinal);
    }
}
