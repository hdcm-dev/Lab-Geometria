@* Barra de filtros: filtra sobre lo ya recibido, no consulta al servicio de datos. *@
<div class="gf-filters">
    <div class="gf-field gf-field-search">
        <label for="works-search">Buscar por nombre</label>
        <input class="gf-input" id="works-search" type="search" placeholder="nombre del trabajo" />
    </div>
    <div class="gf-field">
        <label for="works-state">Estado</label>
        <select class="gf-select" id="works-state">
