@page "/mi-contrasena"
@layout WorkShell
@inject NavigationManager Navigation
@inject DataServiceClient DataService
@inject SessionState Session
@rendermode InteractiveServer

@* SUP-04 `Credencial-Propia` — CU-03, curso de cambio voluntario.
   Ruta: `/mi-contrasena`. Shell: trabajo, con la barra lateral del papel.
   Salida: `NAV-13` → `/mis-trabajos` si el papel es alumno, `/entrega-comision` si es administrador.
   Wireframe: `SDD/Docs/Proyectos/GeometriaFactory-Web/03-UX-UI-DX/Wireframes-Credencial-Propia.md` §1 y §2.
   Maqueta: `SDD/Maquetas/GeometriaFactory-Web/Credencial-Propia.html`, estado `curso-cambio`.
   Componentes que la maqueta declara acá: CMP-04, CMP-07, CMP-08, CMP-09, CMP-11 a CMP-15.

   ETAPA `c`: la pantalla PASA A FUNCIONAR. Exige la contraseña vigente, cambia la propia y no
   emite ninguna sesión nueva: la que la persona ya tiene sigue vigente, que es lo que dice el
   texto de la maqueta.

   LA CREDENCIAL DE SESIÓN NO PASA POR ACÁ. Esta pantalla no la lee ni la escribe: le pide al
   custodio que la use, y quien la adjunta a la petición es el cliente del servicio de datos, del
   lado del servidor. No hay ninguna expresión de este archivo que la interpole en el marcado.
   Desde que la sesión vive en la marca del navegador más el almacén del servidor, el custodio
   necesita que le pidan cargar la identidad antes de leerla: es lo que hace `OnInitializedAsync`,
   una vez, porque dentro de un circuito el contexto de la petición ya no existe.

   SIN SESIÓN NO SE REDIRIGE, SE DICE. Redirigir desde el prerrenderizado devolvería un `302` a
   una dirección que la etapa `b` verifica que responde `200` con su encabezado, y romper esa
   puerta para ganar una redirección sería un mal negocio. La pantalla se dibuja entera y el
   formulario cede el lugar al aviso de que hay que entrar.

   ACÁ SÍ HAY «CANCELAR»: hay un panel al que volver y la salida es legítima. Su destino depende
   del papel, que desde esta etapa sale de la sesión y ya no de la dirección; el parámetro
   `papel` sobrevive sólo como repliegue mientras no hay sesión, que es lo que la barra lateral
   sigue necesitando. *@

<PageTitle>Mi contraseña</PageTitle>

<div class="gf-page-header gf-mt-5">
    <div>
        <h1>Mi contraseña</h1>
        <p class="gf-subtitle">Para cambiarla tenés que escribir la que usás hoy.</p>
    </div>
</div>

@if (!Session.IsOpen)
{
    <p class="gf-banner gf-banner--info gf-width-medium" role="status">
        Para cambiar tu contraseña tenés que estar dentro del laboratorio.
        <a href="/ingreso">Ir a ingresar</a>.
    </p>
}
else
{
    @if (_state is Outcome.MissingFields)
    {
        <p class="gf-banner gf-banner--error gf-width-medium" role="alert">Completá los tres campos.</p>
    }
    else if (_state is Outcome.Mismatch)
    {
        <p class="gf-banner gf-banner--error gf-width-medium" role="alert">
            Las dos contraseñas no coinciden. Escribí la misma en los dos campos.
            No salió ninguna solicitud hacia el servicio de datos.
        </p>
    }
    else if (_state is Outcome.CurrentRejected)
    {
        <p class="gf-banner gf-banner--error gf-width-medium" role="alert">
            La contraseña que usás hoy no corresponde. El cambio no se aplicó.
        </p>
    }
    else if (_state is Outcome.Rejected)
    {
        <p class="gf-banner gf-banner--error gf-width-medium" role="alert">@_rejectionMessage</p>
    }
    else if (_state is Outcome.Replaced)
    {
        <p class="gf-banner gf-banner--confirmation gf-width-medium" role="status">
            Tu contraseña quedó reemplazada. Tu sesión sigue vigente y la anterior deja de servir.
        </p>
    }

    @if (_state is Outcome.Unavailable)
    {
        <div class="gf-unavailable-notice gf-mb-5" role="alert">
            <h2>No pudimos guardar tu contraseña</h2>
            <p>El laboratorio está en pie, pero no está pudiendo llegar a tus datos. Probá de nuevo.</p>
        </div>
    }

    <section class="gf-card gf-width-medium" aria-labelledby="credential-change-heading">
        <h2 id="credential-change-heading" class="gf-sr-only">Cambiar la contraseña</h2>
        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div class="gf-field">
                <label for="credential-current">Contraseña actual</label>
                <input class="gf-input" id="credential-current" name="currentPassword" type="password"
                       autocomplete="current-password" @bind="_current" @bind:event="oninput" disabled="@(_sending || !_listo)" />
            </div>
            <div class="gf-field">
                <label for="credential-change-new">Contraseña nueva</label>
                <input class="gf-input" id="credential-change-new" name="newPassword" type="password"
                       autocomplete="new-password" aria-describedby="credential-change-requirement"
                       @bind="_new" @bind:event="oninput" disabled="@(_sending || !_listo)" />
                <span class="gf-requirement" id="credential-change-requirement">Vas a usarla para entrar; no hay forma de recuperarla.</span>
            </div>
            <div class="gf-field">
                <label for="credential-change-new-repeat">Repetir contraseña nueva</label>
                <input class="gf-input" id="credential-change-new-repeat" name="newPasswordRepeat" type="password"
                       autocomplete="new-password" @bind="_newRepeat" @bind:event="oninput" disabled="@(_sending || !_listo)" />
            </div>
            <div class="gf-footer-actions">
                <a class="gf-btn gf-btn--secondary" href="@CancelHref">Cancelar</a>
                <button type="submit" class="gf-btn gf-btn--primary" disabled="@(_sending || !_listo)">
                    @if (_sending)
                    {
                        <span class="gf-spinner"></span>
                        <text>Guardando…</text>
                    }
                    else
                    {
                        <text>Guardar contraseña</text>
                    }
                </button>
            </div>
        </form>

@if (!_listo)
{
    @* EL AVISO DE QUE TODAVÍA NO SE PUEDE. Un control que parece disponible y no lo está es peor
       que un control ausente: el primero se lee como un producto roto. Lo sufrió el Product Owner
       cuatro veces en la resolución del trabajo, y acá el precio sería el mismo. *@
    <p class="gf-caption gf-mt-3" role="status" data-gf-preparando>
        Preparando el formulario… La conexión de tiempo real tarda unos segundos en este servidor.
        Ahí se habilita.
    </p>
}

    </section>
}

@code {
    /// <summary>Si el circuito ya está enganchado y el formulario hace algo.</summary>
    /// <remarks>
    /// LA MISMA VENTANA MUERTA QUE SE MIDIÓ EN LA RESOLUCIÓN DEL TRABAJO, y acá pesa igual o más.
    /// Contra el anfitrión real, el 2026-09-02: la página termina de cargar a los 0.9 s y el
    /// control recién responde a los 6.4 s. En el medio la pantalla PARECE lista.
    ///
    /// Y ESTE FORMULARIO NO TIENE RED DE SEGURIDAD: se declara `<form @@onsubmit>` **sin**
    /// `method="post"`, de modo que fuera del circuito no hay envío que valga —el navegador
    /// recarga la página y se lleva lo tipeado—. No es como el cambio obligado, que sí publica
    /// por POST de verdad y funciona sin circuito.
    ///
    /// `OnAfterRender` NO CORRE DURANTE EL PRERRENDERIZADO: la primera vez que corre es, por
    /// definición, el instante en que el envío empieza a llegar al servidor.
    /// </remarks>
    private bool _listo;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _listo = true;
        StateHasChanged();
    }

    private enum Outcome { None, MissingFields, Mismatch, CurrentRejected, Rejected, Replaced, Unavailable }

    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _newRepeat = string.Empty;
    private bool _sending;
    private Outcome _state = Outcome.None;
    private string _rejectionMessage = string.Empty;

    /// Destino de «Cancelar»: el panel de la persona, que depende de su papel. Con sesión abierta
    /// el papel sale de la sesión; sin sesión, de la dirección, igual que en la maqueta.
    private string CancelHref
    {
        get
        {
            if (Session.IsOpen)
            {
                return Session.IsAdministrator ? "/entrega-comision" : "/mis-trabajos";
            }

            return Navigation.ToAbsoluteUri(Navigation.Uri).Query
                .Contains("papel=administrador", StringComparison.Ordinal)
                ? "/entrega-comision"
                : "/mis-trabajos";
        }
    }

    /// La identidad de la marca de sesión se trae una vez, antes del primer dibujo: de ella
    /// dependen el aviso de «tenés que entrar», el destino de «Cancelar» y la credencial.
    protected override Task OnInitializedAsync() => Session.LoadAsync();

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_current)
            || string.IsNullOrWhiteSpace(_new)
            || string.IsNullOrWhiteSpace(_newRepeat))
        {
            _state = Outcome.MissingFields;
            Forget();
            return;
        }

        if (!string.Equals(_new, _newRepeat, StringComparison.Ordinal))
        {
            _state = Outcome.Mismatch;
            Forget();
            return;
        }

        _sending = true;
        _state = Outcome.None;

        // La credencial de sesión se pide al custodio y se le pasa al cliente, que la adjunta
        // del lado del servidor. Este método no la guarda en ningún campo del componente.
        var outcome = await DataService.ChangeOwnPasswordAsync(
            new OwnPasswordChangeRequest(_current, _new),
            Session.UseAccessToken());

        _sending = false;
        Forget();

        if (outcome.Succeeded)
        {
            _state = Outcome.Replaced;
            return;
        }

        _rejectionMessage = outcome.Error!.Message;
        _state = outcome.Error.Code switch
        {
            ErrorCode.InvalidCredentials => Outcome.CurrentRejected,
            ErrorCode.ServiceUnavailable => Outcome.Unavailable,
            ErrorCode.RequiredFieldMissing => Outcome.MissingFields,
            _ => Outcome.Rejected,
        };
    }

    /// Las tres contraseñas se olvidan en cuanto el intento termina, salga como salga.
    private void Forget()
    {
        _current = string.Empty;
        _new = string.Empty;
        _newRepeat = string.Empty;
    }
}
