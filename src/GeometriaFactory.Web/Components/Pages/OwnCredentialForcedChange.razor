@page "/credencial-propia/cambio-obligado"
@layout AccessShell
@inject DataServiceClient DataService
@inject SessionState Session
@inject NavigationManager Navigation

@* SUP-04 `Credencial-Propia` — CU-03, curso de cambio forzado. Capacidad `F-26`.
   Ruta: `/credencial-propia/cambio-obligado`. Shell: acceso, y sin sesión.
   Entrada: desvío desde `Ingreso` tras presentar la provisoria.
   Salida: `/ingreso`, con la marca levantada. Sin `NAV-XX` propio.
   Wireframe: `SDD/Docs/Proyectos/GeometriaFactory-Web/03-UX-UI-DX/Wireframes-Credencial-Propia.md` §1 y §2,
   tercer esquema de §2, §4 y §5, que es de dónde salen TODOS los textos y todos los estados de
   esta pantalla.
   Maqueta: `SDD/Maquetas/GeometriaFactory-Web/Credencial-Propia.html` NO tiene este curso.

   RUTA PROPUESTA, NO VALIDADA VISUALMENTE. `Linea-Base-Visual.md` §6.1 declara expresamente que
   a este curso NADIE LO MIRÓ: no tiene `NAV-XX` ni `CMP-XX` propios y la maqueta aprobada no lo
   dibuja. Su ruta y sus textos se construyen acá porque el wireframe vigente los exige. La
   advertencia vivía en una banda en pantalla; se muda acá, que es donde le sirve a quien
   construye, y el Product Owner la tiene declarada en la línea de base.

   LA PANTALLA PASA A FUNCIONAR, y con eso deja de estar inalcanzable. `PRODUCT-INTAKE` 1.34
   resuelve la contradicción que la dejaba fuera: la operación de cambio admite DOS FORMAS DE
   AUTENTICARSE, y ésta usa la segunda —**la contraseña actual**—, porque RN-13 le niega la
   sesión de trabajo a la cuenta marcada. La provisoria que el docente comunicó es la que
   autentica; no hay ninguna credencial de sesión de por medio, ni antes ni después.

   DE QUÉ CUENTA SE TRATA. Lo anotó el ingreso al recibir el desvío, en el estado del circuito.
   No viaja en la dirección: en la barra del navegador quedaría escrito, y en el historial
   también. Si alguien llega acá de frente, sin haber pasado por el ingreso, la pantalla lo dice
   y ofrece la única salida honesta.

   NO LLEVA «CANCELAR» y sí lleva «Volver al ingreso»: no hay sesión ni estado previo, así que lo
   único que se ofrece es la salida honesta de quien prefiere resolverlo después. La marca no se
   levanta por irse. *@

<PageTitle>Credencial propia</PageTitle>

<h1 class="gf-mt-5">Elegí una contraseña nueva</h1>
<p class="gf-subtitle">El docente te reseteó la clave. La que te pasó sirve sólo para esto: para que elijas la tuya ahora. Él no va a saber cuál elegís.</p>

@if (Session.PasswordChangeEmail is null)
{
    <p class="gf-banner gf-banner--info gf-mt-5" role="status">
        Para cambiar tu contraseña acá, entrá primero con la que te pasó el docente.
        <a href="/ingreso">Ir a ingresar</a>.
    </p>
}
else
{
    @if (_state is Outcome.MissingFields)
    {
        <p class="gf-banner gf-banner--error gf-mt-5" role="alert">Completá los tres campos.</p>
    }
    else if (_state is Outcome.Mismatch)
    {
        <p class="gf-banner gf-banner--error gf-mt-5" role="alert">
            Las dos contraseñas no coinciden. Escribí la misma en los dos campos.
            No salió ninguna solicitud hacia el servicio de datos.
        </p>
    }
    else if (_state is Outcome.ProvisionalRejected)
    {
        @* Estado «Provisoria rechazada» de §5: el mensaje va sobre el campo de la provisoria y
           la marca sigue puesta. *@
        <p class="gf-banner gf-banner--error gf-mt-5" role="alert">
            La contraseña provisoria que escribiste no corresponde. Tu contraseña no cambió.
        </p>
    }
    else if (_state is Outcome.Rejected)
    {
        <p class="gf-banner gf-banner--error gf-mt-5" role="alert">@_rejectionMessage</p>
    }

    @if (_state is Outcome.Unavailable)
    {
        <div class="gf-unavailable-notice gf-margin-block-5" role="alert">
            <h2>No pudimos guardar tu contraseña</h2>
            <p>El laboratorio está en pie, pero no está pudiendo llegar a tus datos en este momento. Probá de nuevo en un rato.</p>
        </div>
    }

    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <div class="gf-field">
            <label for="forced-provisional">Contraseña provisoria</label>
            <input class="gf-input" id="forced-provisional" name="provisionalPassword" type="password"
                   autocomplete="current-password" @bind="_provisional" @bind:event="oninput" disabled="@_sending" />
        </div>
        <div class="gf-field">
            <label for="forced-new">Contraseña nueva</label>
            <input class="gf-input" id="forced-new" name="newPassword" type="password"
                   autocomplete="new-password" aria-describedby="forced-requirement"
                   @bind="_new" @bind:event="oninput" disabled="@_sending" />
            <span class="gf-requirement" id="forced-requirement">Vas a usarla para entrar; no hay forma de recuperarla.</span>
        </div>
        <div class="gf-field">
            <label for="forced-new-repeat">Repetir contraseña nueva</label>
            <input class="gf-input" id="forced-new-repeat" name="newPasswordRepeat" type="password"
                   autocomplete="new-password" @bind="_newRepeat" @bind:event="oninput" disabled="@_sending" />
        </div>

        <button type="submit" class="gf-btn gf-btn--primary gf-btn--full" disabled="@_sending">
            @if (_sending)
            {
                <span class="gf-spinner"></span>
                <text>Guardando…</text>
            }
            else
            {
                <text>Guardar contraseña</text>
            }
        </button>
    </form>
}

<p class="gf-caption gf-mt-5"><a href="/ingreso">Volver al ingreso</a></p>

@code {
    private enum Outcome { None, MissingFields, Mismatch, ProvisionalRejected, Rejected, Unavailable }

    private string _provisional = string.Empty;
    private string _new = string.Empty;
    private string _newRepeat = string.Empty;
    private bool _sending;
    private Outcome _state = Outcome.None;
    private string _rejectionMessage = string.Empty;

    private async Task SubmitAsync()
    {
        var email = Session.PasswordChangeEmail;
        if (email is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_provisional)
            || string.IsNullOrWhiteSpace(_new)
            || string.IsNullOrWhiteSpace(_newRepeat))
        {
            _state = Outcome.MissingFields;
            Forget();
            return;
        }

        if (!string.Equals(_new, _newRepeat, StringComparison.Ordinal))
        {
            _state = Outcome.Mismatch;
            Forget();
            return;
        }

        _sending = true;
        _state = Outcome.None;

        // SIN CREDENCIAL DE SESIÓN, y no es un olvido: no hay ninguna que adjuntar. Lo que
        // autentica es la provisoria, que viaja como contraseña vigente igual que en el cambio
        // corriente, y el correo dice de qué cuenta se trata (intake 1.34).
        var outcome = await DataService.ChangeOwnPasswordAsync(
            new OwnPasswordChangeRequest(_provisional, _new, email),
            accessToken: null);

        _sending = false;
        Forget();

        if (outcome.Succeeded)
        {
            // La marca quedó levantada. La persona vuelve al ingreso, y es AHÍ donde obtiene su
            // sesión de trabajo, con la contraseña nueva: este paso no emite ninguna.
            Session.Close();
            Navigation.NavigateTo("/ingreso?estado=confirmacion-contrasena");
            return;
        }

        _rejectionMessage = outcome.Error!.Message;
        _state = outcome.Error.Code switch
        {
            ErrorCode.InvalidCredentials => Outcome.ProvisionalRejected,
            ErrorCode.ServiceUnavailable => Outcome.Unavailable,
            ErrorCode.RequiredFieldMissing => Outcome.MissingFields,
            _ => Outcome.Rejected,
        };
    }

    /// Las tres contraseñas se olvidan en cuanto el intento termina, salga como salga.
    private void Forget()
    {
        _provisional = string.Empty;
        _new = string.Empty;
        _newRepeat = string.Empty;
    }
}
