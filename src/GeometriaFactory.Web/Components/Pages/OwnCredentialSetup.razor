<PageTitle>Credencial propia</PageTitle>

<StagePlaceholder />

<h1 class="gf-mt-5">Elegí tu contraseña</h1>
<p class="gf-subtitle">Es la primera vez que entrás. El laboratorio nunca te envió una contraseña: la elegís vos ahora.</p>

<form>
    <div class="gf-field">
        <label for="credential-new">Contraseña nueva</label>
        <input class="gf-input" id="credential-new" name="newPassword" type="password"
               autocomplete="new-password" aria-describedby="credential-requirement" />
        <span class="gf-requirement" id="credential-requirement">Vas a usarla para entrar; no hay forma de recuperarla.</span>
    </div>
    <div class="gf-field">
        <label for="credential-new-repeat">Repetir contraseña nueva</label>
        <input class="gf-input" id="credential-new-repeat" name="newPasswordRepeat" type="password"
               autocomplete="new-password" />
    </div>

    <button type="button" class="gf-btn gf-btn--primary gf-btn--full">Guardar contraseña</button>
</form>
