<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dos dependencias salientes: Application y Domain (manifiesto §2).
    Regla de anclaje de versiones (intake, encabezado de la Parte C): toda versión de paquete
    se fija acá explícitamente. Un cambio mayor es una decisión que se documenta.
  -->

  <PropertyGroup>
    <RootNamespace>GeometriaFactory.Infrastructure</RootNamespace>
    <AssemblyName>GeometriaFactory.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GeometriaFactory.Domain/GeometriaFactory.Domain.csproj" />
    <ProjectReference Include="../GeometriaFactory.Application/GeometriaFactory.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Emisión y verificación del acceso firmado (`CU-08`). Versión anclada por la etapa `c`. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <!-- Capa de IA (expediente 0002, ADR-14007): sólo el contrato `IChatClient`, versión fija.
         Lo usa únicamente la carpeta `AI/`; lo comprueba `AiSdkOnlyInInfrastructureAiAndComposition`.
         El adaptador concreto (OllamaSharp) NO se referencia acá: lo elige la composición de la Api. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- LAS FICHAS DEL ASISTENTE SE EMBEBEN DESDE docs-as-code (ARQ-4, ADR-14013): lo que se publica y lo que
       contesta el servicio son el mismo archivo, y no hay una copia que se desincronice. -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs-as-code/ayuda/conceptos/*.md" LogicalName="Conceptos/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
