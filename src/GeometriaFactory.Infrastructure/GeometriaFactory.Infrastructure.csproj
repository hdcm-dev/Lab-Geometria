<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dos dependencias salientes: Application y Domain (manifiesto §2).
    Regla de anclaje de versiones (intake, encabezado de la Parte C): toda versión de paquete
    se fija acá explícitamente. Un cambio mayor es una decisión que se documenta.
  -->

  <PropertyGroup>
    <RootNamespace>GeometriaFactory.Infrastructure</RootNamespace>
    <AssemblyName>GeometriaFactory.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GeometriaFactory.Domain/GeometriaFactory.Domain.csproj" />
    <ProjectReference Include="../GeometriaFactory.Application/GeometriaFactory.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Emisión y verificación del acceso firmado (`CU-08`). Versión anclada por la etapa `c`. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
