# Acto 3 — `CU-00011` sobre el almacén de linaje desconocido.
#
# QUE EL ARRANQUE SE DETENGA ES UNA BUENA NOTICIA Y NO UNA FALLA DEL SAMPLE.
# Ante un linaje que no se entiende el servicio NO arranca: atender peticiones
# sobre un almacén dudoso es peor que no atender ninguna (`US-00028`).

detener_servicio

almacen_dudoso="$trabajo/linaje-desconocido.db"
rm -f "$almacen_dudoso" "$almacen_dudoso"-wal "$almacen_dudoso"-shm
componer_almacen_de_linaje_desconocido "$almacen_dudoso"

registro="${GF_REGISTRO_DETENIDO:-$trabajo/detenido.log}"
arrancar "$almacen_dudoso" "$registro"

# Se sondea durante todo el intento: lo que se cuenta es lo mismo que en la fase
# 1 del acto 1 —respuestas, no errores de conexión— y por el mismo motivo.
atendidas=0
for _ in $(seq 1 300); do
  codigo="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$base/salud" 2>/dev/null)"
  if [ $? -eq 0 ] && [ -n "$codigo" ] && [ "$codigo" != "000" ]; then
    atendidas=$((atendidas + 1))
  fi
  kill -0 "$pid_servicio" 2>/dev/null || break
  sleep 0.2
done

vive=no; kill -0 "$pid_servicio" 2>/dev/null && vive=si
detener_servicio
decir "[3] Arranque sobre un almacen de linaje desconocido: $([ "$vive" = no ] && echo detenido || echo 'SIGUE EN PIE') | peticiones atendidas: $atendidas"

# `RA-03` EN EL PEOR MOMENTO POSIBLE. El mensaje del arranque detenido es el que
# más tienta a incluir la ruta o una traza, porque quien lo lee está
# diagnosticando. Se busca lo que de verdad se filtra, y la ruta del almacén
# cuenta como dirección de servicio interno a los efectos de esa regla.
#
# SE MIRA SÓLO EL MENSAJE, no el registro entero: lo que la regla gobierna es lo
# que el servicio DICE al detenerse. Se toma desde la línea que anuncia la falla.
mensaje="$(sed -n '/Unhandled exception/,$p' "$registro")"
[ -z "$mensaje" ] && mensaje="$(tail -20 "$registro")"

# LAS TRES CATEGORÍAS SE CUENTAN POR SEPARADO, y no juntas en un total. Un
# «3 filtraciones» no dice cuál hay que arreglar, y acá las tres tienen
# gravedades distintas: la ruta identifica el archivo, la traza identifica el
# código, y la dirección identifica la topología.
con_ruta=0; con_direccion=0; con_traza=0
for aguja in "$almacen_dudoso" "$trabajo" 'Data Source='; do
  printf '%s' "$mensaje" | grep -qF -- "$aguja" && con_ruta=1
done
printf '%s' "$mensaje" | grep -qF -- "$base" && con_direccion=1
printf '%s' "$mensaje" | grep -qP '^\s+at [\w.<>+`]+\(' && con_traza=1

if [ "$con_ruta" -eq 0 ] && [ "$con_direccion" -eq 0 ] && [ "$con_traza" -eq 0 ]; then
  decir "[3] Mensaje del arranque detenido: sin ruta, sin direccion y sin traza"
else
  decir "[3] Mensaje del arranque detenido: ruta: $([ "$con_ruta" -eq 1 ] && echo si || echo no) | direccion: $([ "$con_direccion" -eq 1 ] && echo si || echo no) | traza: $([ "$con_traza" -eq 1 ] && echo si || echo no)"
fi
